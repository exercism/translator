#!/usr/bin/env bash
#
# create-forum-glossary-post — create the pinned glossary discussion thread for a
# language on the Exercism Discourse forum, then record the IDs in the language's
# tracking.json.
#
# Usage:
#   ./scripts/create-forum-glossary-post <lang>
#
# Example:
#   ./scripts/create-forum-glossary-post pt-BR
#
# The language name is read from languages/names.json. Add the locale there before
# running this script if it is not already present.
#
# The category slug is derived as i18n-<lowercased lang with hyphens>
# (e.g. pt-BR -> i18n-pt-br). The category must already exist; run
# create-forum-language-category first if it does not.
#
# Reads credentials from the repo .env:
#   DISCOURSE_API_KEY, DISCOURSE_API_USERNAME   (the forum's address is config.json `forum.base`)
#
# Reads:   languages/names.json, languages/<lang>/glossary.md (existence check only)
# Updates: languages/<lang>/tracking.json
#
# The post LINKS to languages/<lang>/glossary.md on GitHub rather than carrying
# the table itself, so there is exactly one live copy of the agreed terms (see
# scripts/glossary-post-body for why). That file must be PUSHED before this post
# goes up, or the link lands on nothing.
#
# TODO(iHiD): UNVERIFIED RIGHTS. Creating a topic and pinning it need a forum API
# user who may post in the language's category and pin there. See orchestrator.md.
#
# The body itself comes from ./scripts/glossary-post-body, which is its one home;
# /update-guide-and-glossary reprints the same thing when refreshing the post.
#
# Idempotent: if a glossary post is already tracked for this language in
# languages/<lang>/tracking.json, exits without creating a duplicate.
#
# Requires: curl, jq.

set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

command -v curl >/dev/null || die "curl is required"
command -v jq   >/dev/null || die "jq is required"

LANG="${1:-}"
[ -n "$LANG" ] || die "usage: $(basename "$0") <lang>"

# Guard against a spelled-out language name slipping in as $lang (e.g. "ukrainian"
# instead of "uk") — this becomes the live Discourse category slug (i18n-<lang>), so a
# wrong value here creates a real, hard-to-rename external category.
echo "$LANG" | grep -qE '^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$' ||
  die "'$LANG' doesn't look like a locale code (expected e.g. 'de', 'pt-BR', 'zh-CN'); use the ISO code, not the spelled-out language name"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Shared forum response handling (forum_ok); see the header of that file.
. "$ROOT/scripts/lib/forum-api.sh"
NAMES="$ROOT/languages/names.json"
GLOSSARY="$ROOT/languages/$LANG/glossary.md"
TRACKING="$ROOT/languages/$LANG/tracking.json"

[ -f "$NAMES"    ] || die "names file not found: $NAMES"
[ -f "$GLOSSARY" ] || die "glossary not found: $GLOSSARY"

# Family rows (languages/<family>/glossary.md) need no handling here: the post
# only links, and scripts/glossary-post-body links the family file as well.

LANG_NAME="$(jq -r --arg l "$LANG" '.[$l] // empty' "$NAMES")"
[ -n "$LANG_NAME" ] || die "locale '$LANG' not found in $NAMES — add it before running this script"

[ -f "$ROOT/.env" ] || die "no .env at $ROOT/.env (need DISCOURSE_API_KEY; see .env.example)"
set -a
# shellcheck disable=SC1091
. "$ROOT/.env"
set +a
FORUM_BASE="${FORUM_BASE:-$(jq -r .forum.base "$ROOT/config.json")}"
: "${DISCOURSE_API_KEY:?DISCOURSE_API_KEY not set in .env}"
DISCOURSE_API_USERNAME="${DISCOURSE_API_USERNAME:-system}"

AUTH=(-H "Api-Key: ${DISCOURSE_API_KEY}" -H "Api-Username: ${DISCOURSE_API_USERNAME}")

# Derive category slug: i18n-<lang lowercased, underscores to hyphens>.
CAT_SLUG="i18n-$(echo "$LANG" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"

# Exit early if already tracked.
if [ -f "$TRACKING" ]; then
  existing="$(jq -r '.glossary.topic_id // empty' "$TRACKING" 2>/dev/null || true)"
  if [ -n "$existing" ] && [ "$existing" != "null" ]; then
    echo "glossary post already tracked for $LANG (topic $existing); skipping" >&2
    echo "done (already exists): $FORUM_BASE/t/$existing"
    exit 0
  fi
fi

# Look up the category ID from Discourse.
site="$(curl -sSL -m 15 "$FORUM_BASE/site.json")"
CAT_ID="$(echo "$site" | jq -r --arg s "$CAT_SLUG" '.categories[] | select(.slug==$s) | .id' | head -1)"
[ -n "$CAT_ID" ] || die "category '$CAT_SLUG' not found on $FORUM_BASE — run create-forum-language-category first"

# The post is a pointer, not a copy of the table. The wording lives in exactly
# one place, scripts/glossary-post-body, because the refresh path
# (/update-guide-and-glossary) has to write the identical body.
BODY="$("$ROOT/scripts/glossary-post-body" "$LANG")"

# Every thread we ask a language's speakers to review is titled
# "[<Language> Review] <what>", so the category reads as a list of things needing
# a look rather than a list of nouns, and a reply notification says which
# language it is about without opening it.
TITLE="[${LANG_NAME} Review] Glossary"

resp="$(curl -sS -m 30 -X POST "$FORUM_BASE/posts.json" "${AUTH[@]}" \
  -H "Content-Type: application/json" \
  -w $'\n%{http_code}' \
  -d "$(jq -n --arg t "$TITLE" --arg r "$BODY" --argjson c "$CAT_ID" \
    '{title:$t, raw:$r, category:$c}')")"
RESP_BODY="$(forum_ok "creating the glossary topic" "$resp")" || exit 1

TOPIC_ID="$(printf '%s' "$RESP_BODY" | jq -r '.topic_id // empty')"
POST_ID="$(printf '%s' "$RESP_BODY" | jq -r '.id // empty')"
[ -n "$TOPIC_ID" ] || die "failed to create topic: $(printf '%s' "$RESP_BODY" | jq -c '.errors // .')"
echo "created glossary topic -> id $TOPIC_ID (post $POST_ID)" >&2

# Pin the topic to the category.
curl -sS -m 15 -X PUT "$FORUM_BASE/t/${TOPIC_ID}/status.json" "${AUTH[@]}" \
  -d "status=pinned&enabled=true" -o /dev/null -w ""
echo "pinned topic $TOPIC_ID in category $CAT_ID" >&2

# Update languages/<lang>/tracking.json — merge the forum fields into the file,
# preserving any other fields already there (the language name lives in
# names.json, not here).
#
# `. + {...}` rather than a literal object: this script knows about the glossary
# fields only, and rebuilding the file from them would drop whatever else lives
# there.
BASE='{}'
[ -f "$TRACKING" ] && BASE="$(cat "$TRACKING")"
updated="$(echo "$BASE" | jq \
  --arg s "$CAT_SLUG" \
  --argjson cid "$CAT_ID" \
  --argjson tid "$TOPIC_ID" \
  --argjson pid "$POST_ID" \
  '. + {category_slug: $s, category_id: $cid,
    glossary: ((.glossary // {}) + {
      topic_id: $tid, post_id: $pid,
      ever_updated: ((.glossary // {}).ever_updated // false),
      announced_through: ((.glossary // {}).announced_through // null),
      status: ((.glossary // {}).status // "")})}')"
echo "$updated" > "$TRACKING"
echo "updated $TRACKING" >&2

echo "done: $FORUM_BASE/t/${TOPIC_ID}"
