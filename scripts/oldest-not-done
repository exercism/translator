#!/usr/bin/env bash
#
# oldest-not-done — print the earliest entry in state/forum-todo.jsonl that
# still needs actioning: `status` is missing or anything other than "done"
# (so a fresh, untriaged post and one explicitly reopened as "not done" both
# match). The file is append-only in arrival order, so "first match by line
# number" is "oldest".
#
# Usage:
#   ./scripts/oldest-not-done        # print the oldest not-done entry
#   ./scripts/oldest-not-done -n 5   # print the oldest 5 not-done entries
#
# Output: one compact JSON object per line, `{"line": <1-based line number
# in the file>, "entry": <the parsed JSONL object>}`, so a match can be
# found and edited in place.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TODO="$ROOT/state/forum-todo.jsonl"

N=1
if [ "${1:-}" = "-n" ]; then
  N="${2:?-n requires a count}"
fi

command -v jq >/dev/null || { echo "error: jq is required" >&2; exit 1; }

jq -R -c '
  select(length > 0)
  | {line: input_line_number, entry: (try fromjson catch null)}
' "$TODO" \
  | jq -c 'select(.entry != null and .entry.status != "done")' \
  | head -n "$N" || true
