#!/usr/bin/env bash
#
# glossary-post-body: the canonical body of a language's pinned forum glossary
# post. With no flag it prints the body to stdout and touches nothing.
#
# Usage:
#   ./scripts/glossary-post-body <lang>            print the body
#   ./scripts/glossary-post-body <lang> --links    print only the GitHub link(s)
#   ./scripts/glossary-post-body <lang> --diff     diff the LIVE post against the body (reads only)
#   ./scripts/glossary-post-body <lang> --push     rewrite the live post with the body
#
# ## The body LINKS to the glossary on GitHub. It does not carry the table.
#
# There is no review site for Exercism, so there is no rendered glossary page to
# point at. The choice was between pasting the table into the post and linking
# the Markdown file on GitHub, and this links, for three reasons:
#
#   - a full glossary runs to 100+ rows, which is unreadable in a forum post,
#     especially on a phone, and GitHub renders a Markdown table well;
#   - a pasted table is a second copy of the glossary, stale the moment a term is
#     agreed, and "two copies of a glossary is two glossaries";
#   - a link to a heading (`...glossary.md#product-vocabulary`) lets a reply point
#     at one section, which a forum post cannot offer.
#
# The cost: a change is visible to reviewers only once THIS REPO IS PUSHED, so
# "commit, push, reply" replaces Jiki's "publish, deploy, reply" (see
# global/workflow.md), and the link is dead until the repo exists on GitHub and is
# readable by the reviewers.
#
# TODO(iHiD): this assumes config.json `github.translator_repo` is pushed to
# GitHub and PUBLIC. If it stays private, switch this to carrying the table.
#
# A family locale's glossary is two files, the family's shared rows and the
# locale's own, so both are linked.
#
# This is the one home for the wording. Both consumers shell out to it:
#   - scripts/create-forum-glossary-post   (first post for a new language)
#   - /update-guide-and-glossary           (checking the live post has not drifted)
#
# Reads:   languages/names.json, config.json, and for --diff/--push
#          languages/<lang>/tracking.json and .env
# Requires: jq (and curl for --diff/--push).

set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

command -v jq >/dev/null || die "jq is required"

LANG_CODE="${1:-}"
MODE="${2:-}"
[ -n "$LANG_CODE" ] || die "usage: $(basename "$0") <lang> [--links|--diff|--push]"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
NAMES="$ROOT/languages/names.json"

[ -f "$NAMES" ] || die "names file not found: $NAMES"

LANG_NAME="$(jq -r --arg l "$LANG_CODE" '.[$l] // empty' "$NAMES")"
[ -n "$LANG_NAME" ] || die "locale '$LANG_CODE' not found in $NAMES: add it before running this script"

REPO="$(jq -r .github.translator_repo "$ROOT/config.json")"
BLOB="https://github.com/${REPO}/blob/main/languages"

FAMILY="${LANG_CODE%%-*}"
LINKS="- [The ${LANG_NAME} glossary](${BLOB}/${LANG_CODE}/glossary.md)"
if [ "$FAMILY" != "$LANG_CODE" ] && [ -d "$ROOT/languages/$FAMILY" ]; then
  # names.json holds locales, not families. A family's name is the last word of
  # any of its locales' names: "Brazilian Portuguese" -> "Portuguese".
  FAMILY_NAME="${LANG_NAME##* }"
  LINKS="- [The terms shared by every variety of ${FAMILY_NAME}](${BLOB}/${FAMILY}/glossary.md)
${LINKS} (what is particular to ${LANG_NAME})"
fi

body() {
cat << ENDOFBODY
One of the most crucial steps in translating Exercism is determining the right terms to consistently use throughout. Generally these are technical terms, or Exercism's own vocabulary (track, mentoring, iteration and so on). This is a thread, intended to go on forever, where we can highlight incorrect terms and agree correct variants.

The current ${LANG_NAME} glossary lives here:

${LINKS}

That file is always the live version: we update it as soon as we agree a change here, so check it before relying on anything quoted further down this thread. The decisions behind it, and who made them, are in \`glossary-notes.md\` beside it.

When something is wrong, quote the row here (copy the term and what we render it as) and tell us what it should be instead. That way we know exactly which decision you are giving feedback on.

---

Please use this thread to discuss any changes or additions you think should be made. **Please do NOT use LLMs to generate suggestions and only use your own personal knowledge**.
ENDOFBODY
}

case "$MODE" in
  "") body; exit 0 ;;
  --links) printf '%s\n' "$LINKS"; exit 0 ;;
  --diff|--push) ;;
  *) die "unknown flag '$MODE'" ;;
esac

command -v curl >/dev/null || die "curl is required"
TRACKING="$ROOT/languages/$LANG_CODE/tracking.json"
[ -f "$TRACKING" ] || die "tracking file not found: $TRACKING"
POST_ID="$(jq -r '.glossary.post_id // empty' "$TRACKING")"
[ -n "$POST_ID" ] || die "no glossary.post_id in $TRACKING; the pinned post is created by create-forum-glossary-post"

[ -f "$ROOT/.env" ] || die "no .env at $ROOT/.env (need DISCOURSE_API_KEY; see .env.example)"
set -a
# shellcheck disable=SC1091
. "$ROOT/.env"
set +a
FORUM_BASE="${FORUM_BASE:-$(jq -r .forum.base "$ROOT/config.json")}"
: "${DISCOURSE_API_KEY:?DISCOURSE_API_KEY not set in .env}"
AUTH=(-H "Api-Key: ${DISCOURSE_API_KEY}" -H "Api-Username: ${DISCOURSE_API_USERNAME:-system}")

if [ "$MODE" = "--diff" ]; then
  diff <(curl -sSL -m 20 "${AUTH[@]}" "$FORUM_BASE/posts/${POST_ID}.json" | jq -r '.raw') <(body) || true
  exit 0
fi

# --push. Editing a post is visible in its history; the caller has confirmed the
# body with the operator first. Never retried: see "Forum conduct" in orchestrator.md.
. "$ROOT/scripts/lib/forum-api.sh"
resp="$(curl -sS -m 30 -X PUT "$FORUM_BASE/posts/${POST_ID}.json" "${AUTH[@]}" \
  -H "Content-Type: application/json" \
  -w $'\n%{http_code}' \
  -d "$(jq -n --arg raw "$(body)" '{post:{raw:$raw}}')")"
forum_ok "rewriting the pinned glossary post" "$resp" >/dev/null || exit 1
echo "rewrote post $POST_ID on $FORUM_BASE" >&2
